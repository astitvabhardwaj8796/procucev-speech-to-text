# Server
PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/speech_to_text
# Set to true for managed databases that require TLS (Neon, Supabase, Render external URL)
DATABASE_SSL=false

# Gemini Live (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
